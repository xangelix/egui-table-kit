# Table
total-rows = { $count ->
    [one] মোট { $count } টি সারি
   *[other] মোট { $count } টি সারি
}
passing-filter = ফিল্টার পাস করছে
selected = নির্বাচিত

# Table Header
column-options = কলাম অপশন
filter-text = ফিল্টার টেক্সট
case-insensitive = কেস ইনসেনসিটিভ (Case Insensitive)
remove-filter = ফিল্টার সরান
new-highlight-filter = নতুন হাইলাইট ফিল্টার 〽

toggle-sort = সর্ট টগল করুন ↕
current-ascending = (বর্তমান: অ্যাসেনন্ডিং/ছোট থেকে বড়)
current-descending = (বর্তমান: ডিসেন্ডিং/বড় থেকে ছোট)
regular-expression =
    রেগুলার এক্সপ্রেশন (Regular Expression)
    অবৈধ regex হলে, এটি কিছুই ফিল্টার করবে না।

# Operations
operation-pending = এই অপারেশনটি বর্তমানে পেন্ডিং আছে।
operation-at-least-one = এই অপারেশন ব্যবহার করতে আপনাকে অন্তত একটি সারি (row) নির্বাচন করতে হবে।
operation-one = এই অপারেশন ব্যবহার করতে আপনাকে ঠিক একটি সারি (row) নির্বাচন করতে হবে।
operation-at-least-one-filtered = এই অপারেশন ব্যবহার করতে আপনাকে টেবিলটি ফিল্টার করতে হবে।

error = ত্রুটি:
cancel = বাতিল
close = বন্ধ করুন

copy-hovered-rows = হোভার করা সারিগুলো কপি করুন
copy-rows = সারিগুলো কপি করুন

copy-hovered-rows-with-headers = হোভার করা সারিগুলো কপি করুন (হেডার সহ)
copy-rows-with-headers = সারিগুলো কপি করুন (হেডার সহ)
select-filtered = ফিল্টার করাগুলো নির্বাচন করুন
deselect-filtered = ফিল্টার করাগুলো থেকে নির্বাচন সরান

select-all = সব নির্বাচন করুন
deselect-all = সব নির্বাচন বাতিল করুন
