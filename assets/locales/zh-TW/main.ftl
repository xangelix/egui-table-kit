# Table
total-rows = { $count ->
    [one] 總共 { $count } 列
   *[other] 總共 { $count } 列
}
passing-filter = 符合篩選條件
selected = 已選取

# Table Header
column-options = 欄位選項
filter-text = 篩選文字 🔍
case-insensitive = 不區分大小寫
remove-filter = 移除篩選條件
new-highlight-filter = 新增強調篩選條件 〽

toggle-sort = 切換排序 ↕
current-ascending = (目前：升冪)
current-descending = (目前：降冪)
regular-expression =
    正規表示式 (Regex)
    若 Regex 無效，將不會篩選任何內容。

# Operations
operation-pending = 此作業目前處於擱置狀態。
operation-at-least-one = 您必須選取至少一列才能使用此作業。
operation-one = 您必須剛好選取一列才能使用此作業。
operation-at-least-one-filtered = 您必須篩選表格才能使用此作業。

error = 錯誤：
cancel = 取消
close = 關閉

copy-hovered-rows = 複製滑鼠游標下的列
copy-rows = 複製列

copy-hovered-rows-with-headers = 複製滑鼠游標下的列（含標頭）
copy-rows-with-headers = 複製列（含標頭）
select-filtered = 選取已篩選項目
deselect-filtered = 取消選取已篩選項目

select-all = 全選
deselect-all = 取消全選
