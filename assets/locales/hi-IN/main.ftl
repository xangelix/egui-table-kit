# Table
total-rows = { $count ->
    [one] कुल { $count } पंक्ति
   *[other] कुल { $count } पंक्तियाँ
}
passing-filter = फ़िल्टर पास कर रहा है
selected = चयनित

# Table Header
column-options = कॉलम विकल्प
filter-text = टेक्स्ट फ़िल्टर करें 🔍
case-insensitive = केस असंवेदनशील (Case Insensitive)
remove-filter = फ़िल्टर हटाएँ
new-highlight-filter = नया हाईलाइट फ़िल्टर 〽

toggle-sort = टॉगल सॉर्ट ↕
current-ascending = (वर्तमान: आरोही)
current-descending = (वर्तमान: अवरोही)
regular-expression =
    रेगुलर एक्सप्रेशन (Regular Expression)
    यदि regex अमान्य है, तो यह कुछ भी फ़िल्टर नहीं करेगा।

# Operations
operation-pending = यह ऑपरेशन अभी पेंडिंग है।
operation-at-least-one = इस ऑपरेशन का उपयोग करने के लिए आपको कम से कम एक पंक्ति का चयन करना होगा।
operation-one = इस ऑपरेशन का उपयोग करने के लिए आपको ठीक एक पंक्ति का चयन करना होगा।
operation-at-least-one-filtered = इस ऑपरेशन का उपयोग करने के लिए आपको टेबल को फ़िल्टर करना होगा।

error = त्रुटि:
cancel = रद्द करें
close = बंद करें

copy-hovered-rows = होवर की गई पंक्तियाँ कॉपी करें
copy-rows = पंक्तियाँ कॉपी करें

copy-hovered-rows-with-headers = होवर की गई पंक्तियाँ कॉपी करें (हेडर्स के साथ)
copy-rows-with-headers = पंक्तियाँ कॉपी करें (हेडर्स के साथ)
select-filtered = फ़िल्टर किए गए को चुनें
deselect-filtered = फ़िल्टर किए गए को अचयनित (deselect) करें

select-all = सभी चुनें
deselect-all = सभी को अचयनित करें
